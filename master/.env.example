# entry point
listen=0.0.0.0
port=25565

# node status polling — interval in seconds between polls
poll_interval=15

# DB directory (experiments, etc.)
db_dir=/home/pengyt/projects/neu_box/master/db

LOG_LEVEL=WARNING  # 可选，日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）

# 实验日志缓存目录（保存时从 worker 拉取副本，避免任务删除后日志丢失）
EXP_LOG_DIR=/home/pengyt/projects/neu_box/master/logs/exp

SECRET_KEY=