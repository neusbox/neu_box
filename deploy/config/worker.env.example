# Neu Box Worker runtime configuration

NEU_BOX_LISTEN=0.0.0.0
NEU_BOX_PORT=59075
NEU_BOX_HTTP_THREADS=8

NEU_BOX_DB_PATH=/var/lib/neu-box/worker/neu_box.db
NEU_BOX_TASK_LOG_DIR=/var/lib/neu-box/worker/task-logs
NEU_BOX_LOG_DIR=/var/log/neu-box
NEU_BOX_BACKUP_DIR=/var/backups/neu-box

# The packaged sandbox executable is owned by the neu-box-worker RPM.
NEU_BOX_SANDBOX_EXECUTABLE=/usr/libexec/neu-box/neu-box-sandbox

# Full-match regex for managed accelerator device nodes.
# NPU example: davinci[0-9]+
# GPU example: nvidia[0-9]+
NEU_BOX_DEVICE_FILTER=davinci[0-9]+

# NPU nodes use npu_info.sh by default. GPU nodes change this to gpu_info.sh.
NEU_BOX_DEVICE_INFO_SCRIPT=/usr/share/neu-box/info/npu_info.sh

NEU_BOX_SANDBOX_REAPER_INTERVAL=30
NEU_BOX_COMMAND_TIMEOUT=0
NEU_BOX_COMMAND_MAX_COMPLETED=200
NEU_BOX_COMMAND_QUEUE_RECENT=200
LOG_LEVEL=INFO
