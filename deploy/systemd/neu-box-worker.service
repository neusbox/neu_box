[Unit]
Description=Neu Box Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/neu-box/worker
EnvironmentFile=/etc/neu-box/worker.env
ExecStart=/opt/neu-box/current/worker/neu-box-worker --config /etc/neu-box/worker.env serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0027
Delegate=yes
LimitMEMLOCK=infinity
TasksMax=infinity

[Install]
WantedBy=multi-user.target

